NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Hackers Campus
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
SECRET_KEY=change-me
SESSION_COOKIE_NAME=hackers_campus_session

DATABASE_URL=postgresql+psycopg://hackers:campus@localhost:5432/hackers_campus
REDIS_URL=redis://localhost:6379/0

# Lab network. Keep the bridge defaults for development.
# Production campus deployments should use macvlan and a DHCP-reserved range.
LAB_NETWORK_NAME=hc-labs
LAB_NETWORK_DRIVER=bridge
LAB_NETWORK_SUBNET=172.31.0.0/16
LAB_NETWORK_GATEWAY=172.31.0.1
# LAB_NETWORK_PARENT=ens33
# LAB_NETWORK_IP_RANGE=10.68.118.160/27

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
